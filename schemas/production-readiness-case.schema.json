{
  "title": "PRH case manifest",
  "type": "object",
  "required": ["schema_version", "case_id", "skill", "contract", "permissions", "model", "evaluation", "operations", "governance", "release", "evidence"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "case_id": {"type": "string", "minLength": 1},
    "skill": {
      "type": "object",
      "required": ["id", "version", "owner", "purpose", "scope"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1},
        "purpose": {"type": "string", "minLength": 1},
        "scope": {"type": "object", "required": ["allowed_paths", "forbidden_paths"], "properties": {
          "allowed_paths": {"type": "array", "items": {"type": "string"}},
          "forbidden_paths": {"type": "array", "items": {"type": "string"}}
        }}
      }
    },
    "contract": {"type": "object", "required": ["inputs", "outputs", "limitations", "acceptance_criteria"], "properties": {
      "inputs": {"type": "array", "items": {"type": "string"}},
      "outputs": {"type": "array", "items": {"type": "string"}},
      "limitations": {"type": "array", "items": {"type": "string"}},
      "acceptance_criteria": {"type": "array", "items": {"type": "string"}}
    }},
    "permissions": {"type": "object", "required": ["allowed_actions", "denied_actions", "approval_required_for", "overbroad", "least_privilege_test"], "properties": {
      "allowed_actions": {"type": "array", "items": {"type": "string"}},
      "denied_actions": {"type": "array", "items": {"type": "string"}},
      "approval_required_for": {"type": "array", "items": {"type": "string"}},
      "overbroad": {"type": ["boolean", "null"]},
      "least_privilege_test": {"$ref": "#/$defs/check"}
    }},
    "model": {"type": "object", "required": ["provider", "model_id", "task_profile", "required_capabilities", "qualification", "fallback_test", "version_pinned"], "properties": {
      "provider": {"type": "string"},
      "model_id": {"type": "string"},
      "task_profile": {"type": "string"},
      "required_capabilities": {"type": "array", "items": {"type": "string"}},
      "qualification": {"$ref": "#/$defs/check"},
      "fallback_test": {"$ref": "#/$defs/check"},
      "version_pinned": {"type": "boolean"}
    }},
    "evaluation": {"type": "object", "required": ["baseline_id", "holdout", "independent_verifier", "checks"], "properties": {
      "baseline_id": {"type": "string"},
      "holdout": {"type": "boolean"},
      "independent_verifier": {"$ref": "#/$defs/check"},
      "checks": {"type": "object", "additionalProperties": {"$ref": "#/$defs/check"}}
    }},
    "operations": {"type": "object"},
    "governance": {"type": "object"},
    "release": {"type": "object", "required": ["profile", "approval_status", "authorized_by", "evidence_refs"], "properties": {
      "profile": {"enum": ["research", "internal", "customer_facing", "high_impact"]},
      "approval_status": {"enum": ["PENDING", "APPROVED", "REJECTED", "REVOKED"]},
      "authorized_by": {"type": "string"},
      "evidence_refs": {"type": "array", "items": {"type": "string"}}
    }},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}
  },
  "$defs": {
    "check": {"type": "object", "required": ["status", "evidence_refs"], "properties": {
      "status": {"enum": ["PASS", "FAIL", "NOT_RUN", "UNKNOWN", "BLOCKED", "TOOL_ERROR"]},
      "detail": {"type": "string"},
      "evidence_refs": {"type": "array", "items": {"type": "string"}}
    }},
    "evidence": {"type": "object", "required": ["id", "path", "sha256", "kind", "source", "observed_at", "epistemic_status", "covers"], "properties": {
      "id": {"type": "string", "minLength": 1},
      "path": {"type": "string", "minLength": 1},
      "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
      "kind": {"type": "string"},
      "source": {"type": "string"},
      "observed_at": {"type": "string", "format": "date"},
      "expires_at": {"type": ["string", "null"], "format": "date"},
      "epistemic_status": {"enum": ["VERIFIED", "SUPPORTED", "PROVISIONAL", "INFERRED", "UNKNOWN", "CONTRADICTED"]},
      "covers": {"type": "array", "items": {"type": "string"}}
    }}
  }
}